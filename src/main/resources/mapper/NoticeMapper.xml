<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minbak.web.notice.NoticeMapper">

    <insert id="insertNotice" parameterType="com.minbak.web.notice.NoticeDto" useGeneratedKeys="true" keyProperty="noticeId">
        INSERT INTO notice (user_id, title, content, created_at)
        VALUES (#{userId}, #{title}, #{content}, NOW())
    </insert>


    <!-- 공지사항 목록 조회 -->
    <select id="getNoticeList" resultType="com.minbak.web.notice.NoticeDto">
        SELECT n.notice_id, n.user_id, n.title, n.created_at, n.pinned_num
        FROM notice n
        ORDER BY n.pinned_num DESC, n.created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
    <!-- 공지사항 총 개수 조회 -->
    <select id="getNoticeCount" resultType="int">
        SELECT COUNT(*) FROM notice
    </select>
    <!-- 공지사항 상세 조회 -->
    <select id="getNoticeById" parameterType="int" resultType="com.minbak.web.notice.NoticeDto">
        SELECT * FROM notice WHERE notice_id = #{noticeId}
    </select>


    <update id="updateNotice" parameterType="com.minbak.web.notice.NoticeDto">
        UPDATE notice
        SET title = #{title}, content = #{content}
        WHERE notice_id = #{noticeId}
    </update>

    <delete id="deleteNotice" parameterType="int">
        DELETE FROM notice WHERE notice_id = #{noticeId}
    </delete>




    <!-- 검색된 공지사항 개수 조회 -->
    <select id="getSearchNoticeCount" resultType="int">
        SELECT COUNT(*)
        FROM notice
        <where>
            <choose>
                <when test="searchType == 'title'">
                    AND title LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <when test="searchType == 'content'">
                    AND content LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- 검색된 공지사항 목록 조회 -->
    <select id="searchNotices" resultType="com.minbak.web.notice.NoticeDto">
        SELECT *
        FROM notice
        <where>
            <choose>
                <when test="searchType == 'title'">
                    AND title LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <when test="searchType == 'content'">
                    AND content LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
        ORDER BY created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 공지사항 고정하기 -->
    <update id="pinNotice" parameterType="map">
        UPDATE notice
        SET pinned_num = #{pinnedNum}
        WHERE notice_id = #{noticeId}
    </update>
    <!-- 공지사항 고정 해제하기 -->
    <update id="unpinNotice" parameterType="int">
        UPDATE notice
        SET pinned_num = 0
        WHERE notice_id = #{noticeId}
    </update>
    <!-- 고정된 공지사항과 일반 공지사항을 합쳐서 가져오기 -->
    <select id="getNoticesWithPinned" resultType="com.minbak.web.notice.NoticeDto">
        SELECT *
        FROM notice
        ORDER BY pinned_num DESC, created_at DESC
    </select>


</mapper>