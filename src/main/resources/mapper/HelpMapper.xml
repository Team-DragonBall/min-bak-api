<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minbak.web.help.HelpMapper">

    <insert id="insertHelp" parameterType="com.minbak.web.help.HelpDto" useGeneratedKeys="true" keyProperty="noticeId">
        INSERT INTO notice (user_id, title, content, created_at)
        VALUES (#{userId}, #{title}, #{content}, NOW())
    </insert>

    <!-- 고객 서비스 센터 목록 조회 -->
    <select id="getHelpList" resultType="com.minbak.web.help.HelpDto">
        SELECT n.notice_id AS noticeId, n.user_id, n.title, n.created_at, n.pinned_num
        FROM notice n
        ORDER BY n.pinned_num DESC, n.created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 고객 서비스 센터 총 개수 조회 -->
    <select id="getHelpCount" resultType="int">
        SELECT COUNT(*) FROM notice
    </select>

    <!-- 고객 서비스 센터 상세 조회 -->
    <select id="getHelpById" parameterType="int" resultType="com.minbak.web.help.HelpDto">
        SELECT * FROM notice WHERE notice_id = #{noticeId}
    </select>

    <update id="updateHelp" parameterType="com.minbak.web.help.HelpDto">
        UPDATE notice
        SET title = #{title}, content = #{content}
        WHERE notice_id = #{noticeId}
    </update>

    <delete id="deleteHelp" parameterType="int">
        DELETE FROM notice WHERE notice_id = #{noticeId}
    </delete>

    <!-- 검색된 고객 서비스 센터 개수 조회 -->
    <select id="getSearchHelpCount" resultType="int">
        SELECT COUNT(*)
        FROM notice
        <where>
            <choose>
                <when test="searchType == 'title'">
                    AND title LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <when test="searchType == 'content'">
                    AND content LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- 검색된 고객 서비스 센터 목록 조회 -->
    <select id="searchHelps" resultType="com.minbak.web.help.HelpDto">
        SELECT *
        FROM notice
        <where>
            <choose>
                <when test="searchType == 'title'">
                    AND title LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <when test="searchType == 'content'">
                    AND content LIKE CONCAT('%', #{searchQuery}, '%')
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
        ORDER BY created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 고객 서비스 센터 고정하기 -->
    <update id="pinHelp" parameterType="map">
        UPDATE notice
        SET pinned_num = #{pinnedNum}
        WHERE notice_id = #{noticeId}
    </update>

    <!-- 고객 서비스 센터 고정 해제하기 -->
    <update id="unpinHelp" parameterType="int">
        UPDATE notice
        SET pinned_num = 0
        WHERE notice_id = #{noticeId}
    </update>

    <!-- 고정된 고객 서비스 센터와 일반 고객 서비스 센터를 합쳐서 가져오기 -->
    <select id="getHelpsWithPinned" resultType="com.minbak.web.help.HelpDto">
        SELECT *
        FROM notice
        ORDER BY pinned_num DESC, created_at DESC
    </select>

</mapper>
